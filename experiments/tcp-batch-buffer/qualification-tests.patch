+    #[test]
+    fn delivery_eof_deadlines_recompute_once_after_batch_retirement() {
+        let mut config = Config::local(vec![1; 32]);
+        config.listen.set_port(0);
+        let mut server = Server::bind(config).unwrap();
+        let mut clients = Vec::new();
+        let mut tokens = Vec::new();
+        for _ in 0..3 {
+            clients.push(std::net::TcpStream::connect(server.local_addr().unwrap()).unwrap());
+            accept_stream(&mut server);
+            tokens.push(
+                *server
+                    .connections
+                    .keys()
+                    .max_by_key(|token| token.0)
+                    .unwrap(),
+            );
+        }
+        let now = Instant::now();
+        let deadlines = [
+            now + Duration::from_millis(50),
+            now + Duration::from_millis(100),
+            now + Duration::from_millis(150),
+        ];
+        for (token, deadline) in tokens.iter().zip(deadlines) {
+            let conn = server.connections.get_mut(token).unwrap();
+            conn.drain_until = Some(deadline);
+            conn.queue(b"accepted").unwrap();
+            server.poll.registry().deregister(&mut conn.socket).unwrap();
+        }
+        server.drain_at = Some(deadlines[0]);
+        server.close(tokens[0]);
+        server.close(tokens[1]);
+        assert!(server.drain_at_dirty);
+        assert_eq!(
+            server.drain_at,
+            Some(deadlines[0]),
+            "retirement does not rescan per close"
+        );
+        server.refresh_drain_at();
+        assert!(!server.drain_at_dirty);
+        assert_eq!(server.drain_at, Some(deadlines[2]));
+        assert!(server.pending_streams.is_empty());
+        server
+            .poll
+            .poll(&mut Events::with_capacity(16), Some(Duration::ZERO))
+            .unwrap();
+        server.sweep_at = now + Duration::from_secs(60);
+        let began = Instant::now();
+        server.poll_once(Duration::from_secs(5)).unwrap();
+        assert!(
+            server.connections.is_empty(),
+            "surviving cached deadline expires without readiness"
+        );
+        assert!(began.elapsed() < Duration::from_secs(1));
+        assert!(server.drain_at.is_none() && !server.drain_at_dirty);
+    }
