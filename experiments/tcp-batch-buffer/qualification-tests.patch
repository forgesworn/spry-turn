+    #[cfg(all(feature = "connected-udp", unix))]
+    fn coalescing_loopback() -> (Server, std::net::TcpStream, Token) {
+        let mut config = Config::local(vec![1; 32]);
+        config.listen.set_port(0);
+        let mut server = Server::bind(config).unwrap();
+        let socket = socket2::Socket::new(
+            socket2::Domain::IPV4,
+            socket2::Type::STREAM,
+            Some(socket2::Protocol::TCP),
+        )
+        .unwrap();
+        socket.set_recv_buffer_size(1_048_576).unwrap();
+        socket
+            .connect_timeout(&server.local_addr().unwrap().into(), Duration::from_secs(2))
+            .unwrap();
+        let client: std::net::TcpStream = socket.into();
+        client.set_nonblocking(true).unwrap();
