+    #[cfg(all(feature = "connected-udp", unix))]
+    fn coalescing_udp_dispatch_flushes_at_wouldblock_for_both_framing_paths() {
+        for channel in [None, Some(0x4000_u16)] {
+            let (mut server, mut client, token) = coalescing_loopback();
+            let key = Client::Stream(token);
+            let peer = std::net::UdpSocket::bind("127.0.0.1:0").unwrap();
+            let peer_address = peer.local_addr().unwrap();
+            let relay_socket = UdpSocket::bind("127.0.0.1:0".parse().unwrap()).unwrap();
+            let address = relay_socket.local_addr().unwrap();
+            let relay_token = server.relays.reserve(key);
+            let expires = Instant::now() + Duration::from_secs(60);
+            server.allocations.insert(
+                key,
+                Allocation {
+                    socket: relay_socket,
+                    client_socket: None,
+                    token: relay_token,
+                    bound_address: address,
+                    advertised_address: address,
+                    username: "generated-coalescing-fixture".into(),
+                    transaction: [1; 12],
+                    expires,
+                    permissions: vec![Permission {
+                        ip: peer_address.ip(),
+                        expires,
+                    }],
+                    channels: channel
+                        .map(|number| Channel {
+                            number,
+                            peer: peer_address,
+                            expires,
+                        })
+                        .into_iter()
+                        .collect(),
+                    bandwidth: Bucket::new(64 * 1024 * 1024, 128 * 1024 * 1024, Instant::now()),
+                },
+            );
+            for sequence in 0..4_u8 {
+                assert_eq!(peer.send_to(&[sequence; 16], address).unwrap(), 16);
+            }
+            let queued_by = Instant::now() + Duration::from_secs(2);
+            loop {
+                match server.allocations[&key].socket.peek_from(&mut [0; 16]) {
+                    Ok((16, from)) => {
+                        assert_eq!(from, peer_address);
+                        break;
+                    }
+                    Err(e) if e.kind() == io::ErrorKind::WouldBlock => {
+                        assert!(Instant::now() < queued_by);
+                        std::thread::yield_now();
+                    }
+                    result => panic!("generated UDP prefix: {result:?}"),
+                }
+            }
+            let mut scratch = vec![0; MAX_PACKET + HEADROOM];
+            server.receive_peer(relay_token, &mut scratch);
+            assert_eq!(
+                (server.stats.forwarded_packets, server.stats.forwarded_bytes),
+                (4, 64)
+            );
+            assert!(
+                server.connections[&token].output.is_empty(),
+                "dispatch exit flushes its short batch"
+            );
+            let bytes_per_frame = if channel.is_some() { 20 } else { 52 };
+            client.set_nonblocking(false).unwrap();
+            client
+                .set_read_timeout(Some(Duration::from_secs(2)))
+                .unwrap();
+            let mut received = vec![0; 4 * bytes_per_frame];
+            client.read_exact(&mut received).unwrap();
+            for (sequence, frame) in received.chunks_exact(bytes_per_frame).enumerate() {
+                if let Some(number) = channel {
+                    assert_eq!(
+                        wire::channel(frame),
+                        Some((number, &[sequence as u8; 16][..]))
+                    );
+                } else {
+                    let message = Message::parse(frame).unwrap();
+                    assert_eq!((message.method, message.class), (DATA_METHOD, 1));
+                    assert_eq!(message.address(PEER), Some(peer_address));
+                    assert_eq!(message.attr(DATA), Some(&[sequence as u8; 16][..]));
+                }
+            }
+        }
+    }
