+    fn coalescing_frame(sequence: u8, payload_bytes: usize) -> Vec<u8> {
+        let mut bytes = vec![sequence; (4 + payload_bytes + 3) & !3];
+        bytes[..2].copy_from_slice(&0x4000_u16.to_be_bytes());
+        bytes[2..4].copy_from_slice(&(payload_bytes as u16).to_be_bytes());
+        bytes[4 + payload_bytes..].fill(0);
+        bytes
+    }
