+    fn tls_loopback() -> (
+        TlsFiles,
+        Server,
+        rustls::StreamOwned<rustls::ClientConnection, std::net::TcpStream>,
+        Token,
+    ) {
+        use std::{os::unix::fs::PermissionsExt, process::Stdio};
+
+        let mut random = [0; 8];
+        getrandom::fill(&mut random).unwrap();
+        let path = std::env::temp_dir().join(format!(
+            "spry-turn-tls-test-{}-{:016x}",
+            std::process::id(),
+            u64::from_ne_bytes(random)
+        ));
+        std::fs::create_dir(&path).unwrap();
+        let files = TlsFiles(path);
+        std::fs::set_permissions(&files.0, std::fs::Permissions::from_mode(0o700)).unwrap();
+        let cert = files.0.join("cert.pem");
+        let key = files.0.join("key.pem");
+        let mut child = std::process::Command::new("openssl")
+            .args([
+                "req",
+                "-x509",
+                "-newkey",
+                "rsa:2048",
+                "-nodes",
+                "-days",
+                "1",
+                "-subj",
+                "/CN=localhost",
+                "-addext",
+                "subjectAltName=DNS:localhost,IP:127.0.0.1",
+                "-addext",
+                "basicConstraints=critical,CA:FALSE",
+                "-addext",
+                "extendedKeyUsage=serverAuth",
+                "-keyout",
+            ])
+            .arg(&key)
+            .arg("-out")
+            .arg(&cert)
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .spawn()
+            .unwrap();
+        let deadline = Instant::now() + Duration::from_secs(10);
+        let status = loop {
+            match child.try_wait() {
+                Ok(Some(status)) => break status,
+                Ok(None) if Instant::now() < deadline => {
+                    std::thread::sleep(Duration::from_millis(10));
+                }
+                result => {
+                    let _ = child.kill();
+                    let _ = child.wait();
+                    panic!("bounded test certificate generation failed: {result:?}");
+                }
+            }
+        };
+        assert!(status.success());
+        let certs =
+            rustls_pemfile::certs(&mut io::BufReader::new(std::fs::File::open(cert).unwrap()))
+                .collect::<Result<Vec<_>, _>>()
+                .unwrap();
+        let key =
+            rustls_pemfile::private_key(&mut io::BufReader::new(std::fs::File::open(key).unwrap()))
+                .unwrap()
+                .unwrap();
+        let mut roots = rustls::RootCertStore::empty();
+        for cert in &certs {
+            roots.add(cert.clone()).unwrap();
+        }
+        let tls = rustls::ServerConfig::builder()
+            .with_no_client_auth()
+            .with_single_cert(certs, key)
+            .unwrap();
+        let mut config = Config::local(vec![1; 32]);
+        config.listen.set_port(0);
+        config.tls = Some(("127.0.0.1:0".parse().unwrap(), Arc::new(tls)));
+        let mut server = Server::bind(config).unwrap();
+        let socket = std::net::TcpStream::connect(
+            server.tls_listener.as_ref().unwrap().local_addr().unwrap(),
+        )
+        .unwrap();
+        socket.set_nonblocking(true).unwrap();
+        socket.set_nodelay(true).unwrap();
+        let client = rustls::ClientConfig::builder()
+            .with_root_certificates(roots)
+            .with_no_client_auth();
+        let mut client = rustls::StreamOwned::new(
+            rustls::ClientConnection::new(Arc::new(client), "localhost".try_into().unwrap())
+                .unwrap(),
+            socket,
+        );
+        accept_stream(&mut server);
+        let token = *server.connections.keys().next().unwrap();
+        let deadline = Instant::now() + Duration::from_secs(3);
+        loop {
+            match client.conn.complete_io(&mut client.sock) {
+                Ok(_) => (),
+                Err(error) if error.kind() == io::ErrorKind::WouldBlock => (),
+                Err(error) => panic!("TLS test handshake failed: {error}"),
+            }
+            server.poll_once(Duration::ZERO).unwrap();
+            let tls = server.connections[&token].tls.as_ref().unwrap();
+            if !client.conn.is_handshaking()
+                && !client.conn.wants_write()
+                && !tls.is_handshaking()
+                && !tls.wants_write()
+                && server.pending_streams.is_empty()
+            {
+                break;
+            }
+            assert!(Instant::now() < deadline, "TLS handshake did not finish");
+        }
+        (files, server, client, token)
+    }
