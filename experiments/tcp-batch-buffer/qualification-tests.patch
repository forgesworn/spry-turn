+    #[test]
+    #[cfg(all(feature = "tls", feature = "connected-udp", unix))]
+    fn delivery_tls_write_budget_queues_without_a_fresh_native_event() {
+        let (_files, mut server, mut client, token) = tls_loopback();
+        socket2::SockRef::from(&client.sock)
+            .set_recv_buffer_size(1_048_576)
+            .unwrap();
+        let conn = server.connections.get_mut(&token).unwrap();
+        socket2::SockRef::from(&conn.socket)
+            .set_send_buffer_size(1_048_576)
+            .unwrap();
+        conn.tls.as_mut().unwrap().set_buffer_limit(Some(1024));
+        conn.queue(&vec![0x5a; MAX_QUEUE]).unwrap();
+        conn.update_interest(server.poll.registry(), token, true)
+            .unwrap();
+        server.stream(token, &mut [0; MAX_PACKET + HEADROOM]);
+        assert!(
+            server.connections[&token].queued,
+            "write budget explicitly yields"
+        );
+        assert!(server.connections[&token].writable_interest);
+        // Route every native event to an absent token. Only the explicit
+        // continuation can resume this live connection until its final drain.
+        server
+            .poll
+            .registry()
+            .reregister(
+                &mut server.connections.get_mut(&token).unwrap().socket,
+                Token(usize::MAX),
+                Interest::READABLE | Interest::WRITABLE,
+            )
+            .unwrap();
+        let mut received = 0;
+        let mut bytes = [0; 65_536];
+        let deadline = Instant::now() + Duration::from_secs(2);
+        while received < MAX_QUEUE && Instant::now() < deadline {
+            match client.read(&mut bytes) {
+                Ok(n) => {
+                    assert!(n != 0);
+                    assert!(bytes[..n].iter().all(|byte| *byte == 0x5a));
+                    received += n;
+                }
+                Err(error) if error.kind() == io::ErrorKind::WouldBlock => (),
+                Err(error) => panic!("TLS continuation read: {error}"),
+            }
+            server.poll_once(Duration::ZERO).unwrap();
+        }
+        assert_eq!(received, MAX_QUEUE);
+        let conn = &server.connections[&token];
+        assert!(conn.output.is_empty() && !conn.tls.as_ref().unwrap().wants_write());
+        assert!(!conn.queued && !conn.writable_interest);
+    }
