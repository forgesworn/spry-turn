+    #[test]
+    #[cfg(all(feature = "tls", feature = "connected-udp", unix))]
+    fn delivery_tls_eof_drains_after_real_ciphertext_backpressure() {
+        let (_files, mut server, mut client, token) = tls_loopback();
+        socket2::SockRef::from(&client.sock)
+            .set_recv_buffer_size(4096)
+            .unwrap();
+        socket2::SockRef::from(&server.connections[&token].socket)
+            .set_send_buffer_size(1024)
+            .unwrap();
+        let mut accepted = 0;
+        let mut blocked = false;
+        for _ in 0..1024 {
+            let conn = server.connections.get_mut(&token).unwrap();
+            conn.queue(&[0x5a; 4096]).unwrap();
+            accepted += 4096;
+            for _ in 0..32 {
+                let result = conn.flush().unwrap();
+                if result == StreamFlush::Drained {
+                    break;
+                }
+                if result == StreamFlush::Blocked {
+                    let tls = conn.tls.as_mut().unwrap();
+                    assert!(tls.wants_write());
+                    match tls.write_tls(&mut conn.socket) {
+                        Err(error) if error.kind() == io::ErrorKind::WouldBlock => {
+                            blocked = true;
+                            break;
+                        }
+                        Ok(_) => (),
+                        Err(error) => panic!("TLS kernel pressure: {error}"),
+                    }
+                }
+            }
+            if blocked {
+                break;
+            }
+        }
+        assert!(blocked, "observe ciphertext syscall WouldBlock before EOF");
+        client.sock.shutdown(std::net::Shutdown::Write).unwrap();
+        wait_for_stream_eof(&server, token);
+        server.stream(token, &mut [0; MAX_PACKET + HEADROOM]);
+        assert!(server.connections.contains_key(&token));
+        let mut received = 0;
+        let mut eof = false;
+        let mut bytes = [0; 65_536];
+        let deadline = Instant::now() + Duration::from_secs(3);
+        while !eof && Instant::now() < deadline {
+            match client.read(&mut bytes) {
+                Ok(0) => eof = true,
+                Ok(n) => {
+                    assert!(bytes[..n].iter().all(|byte| *byte == 0x5a));
+                    received += n;
+                }
+                Err(error) if error.kind() == io::ErrorKind::WouldBlock => (),
+                Err(error) => panic!("TLS accepted prefix: {error}"),
+            }
+            server.poll_once(Duration::from_millis(1)).unwrap();
+        }
+        assert!(eof);
+        assert_eq!(received, accepted);
+        assert!(!server.connections.contains_key(&token));
     }
 
