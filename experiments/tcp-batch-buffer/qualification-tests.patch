+    #[test]
+    fn delivery_write_limits_cover_vectored_bytes_interruptions_and_real_block() {
+        #[derive(Default)]
+        struct Writer {
+            calls: usize,
+            bytes: Vec<u8>,
+            error: Option<io::ErrorKind>,
+        }
+        impl Write for Writer {
+            fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+                self.calls += 1;
+                if let Some(error) = self.error {
+                    return Err(error.into());
+                }
+                self.bytes.extend_from_slice(bytes);
+                Ok(bytes.len())
+            }
+            fn write_vectored(&mut self, bytes: &[io::IoSlice<'_>]) -> io::Result<usize> {
+                self.calls += 1;
+                let mut n = 0;
+                for slice in bytes {
+                    self.bytes.extend_from_slice(slice);
+                    n += slice.len();
+                }
+                Ok(n)
+            }
+            fn flush(&mut self) -> io::Result<()> {
+                Ok(())
+            }
+        }
+        let mut writer = Writer::default();
+        let mut budget = WriteBudget {
+            attempts: 2,
+            bytes: 5,
+            limited: false,
+        };
+        let slices = [io::IoSlice::new(b"abc"), io::IoSlice::new(b"def")];
+        assert_eq!(
+            LimitedWriter {
+                socket: &mut writer,
+                budget: &mut budget
+            }
+            .write_vectored(&slices)
+            .unwrap(),
+            5
+        );
+        assert_eq!(writer.bytes, b"abcde");
+        assert_eq!(
+            LimitedWriter {
+                socket: &mut writer,
+                budget: &mut budget
+            }
+            .write(b"x")
+            .unwrap_err()
+            .kind(),
+            io::ErrorKind::WouldBlock
+        );
+        assert_eq!(budget.blocked(), StreamFlush::Yielded);
+        assert_eq!(writer.calls, 1);
+
+        let mut writer = Writer {
+            error: Some(io::ErrorKind::Interrupted),
+            ..Writer::default()
+        };
+        let mut budget = WriteBudget::new();
+        loop {
+            let error = LimitedWriter {
+                socket: &mut writer,
+                budget: &mut budget,
+            }
+            .write(b"x")
+            .unwrap_err();
+            if error.kind() == io::ErrorKind::WouldBlock {
+                break;
+            }
+            assert_eq!(error.kind(), io::ErrorKind::Interrupted);
+        }
+        assert_eq!(writer.calls, STREAM_WRITES_PER_FLUSH);
+        assert_eq!(budget.blocked(), StreamFlush::Yielded);
+
+        let mut writer = Writer {
+            error: Some(io::ErrorKind::WouldBlock),
+            ..Writer::default()
+        };
+        let mut budget = WriteBudget {
+            attempts: 1,
+            bytes: 1,
+            limited: false,
+        };
+        assert_eq!(
+            LimitedWriter {
+                socket: &mut writer,
+                budget: &mut budget
+            }
+            .write(b"x")
+            .unwrap_err()
+            .kind(),
+            io::ErrorKind::WouldBlock
+        );
+        assert_eq!(budget.attempts, 0);
+        assert_eq!(
+            budget.blocked(),
+            StreamFlush::Blocked,
+            "the last permitted syscall blocked; exhaustion did not cause it"
+        );
+    }
