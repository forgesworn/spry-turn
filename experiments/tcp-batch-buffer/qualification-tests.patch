+    #[test]
+    #[cfg(all(feature = "connected-udp", unix))]
+    fn delivery_eof_progress_keeps_its_deadline_and_retires_the_allocation() {
+        let (mut server, mut client, token, _) = backpressured_stream();
+        let peer = server.connections[&token].peer;
+        let mut request = Builder::new(ALLOCATE, 0, [12; 12]);
+        request.attr(TRANSPORT, &[17, 0, 0, 0]);
+        let request = request.finish(None);
+        server.allocate(
+            Client::Stream(token),
+            peer,
+            &Message::parse(&request).unwrap(),
+            format!("{}:delivery-fixture", unix_time() + 600),
+            [7; 16],
+        );
+        assert!(server.allocations.contains_key(&Client::Stream(token)));
+        let relay = server.allocations[&Client::Stream(token)].token;
+        client.shutdown(std::net::Shutdown::Write).unwrap();
+        wait_for_stream_eof(&server, token);
+        server.stream(token, &mut [0; MAX_PACKET + HEADROOM]);
+        assert!(!server.allocations.contains_key(&Client::Stream(token)));
+        assert!(server.relays.get(&relay).is_none());
+        let conn = &server.connections[&token];
+        let deadline = conn.drain_until.unwrap();
+        assert!(!conn.readable_interest);
+        let before = conn.output.len() - conn.written;
+        let mut bytes = [0; 1024];
+        assert!(client.read(&mut bytes).unwrap() > 0);
+        let until = Instant::now() + Duration::from_millis(500);
+        let mut progressed = false;
+        while Instant::now() < until {
+            server.poll_once(Duration::from_millis(1)).unwrap();
+            let conn = server
+                .connections
+                .get(&token)
+                .expect("large accepted tail remains");
+            assert_eq!(conn.drain_until, Some(deadline));
+            if conn.output.len() - conn.written < before {
+                progressed = true;
+                break;
+            }
+        }
+        assert!(progressed, "observe a real write after the EOF transition");
+        assert_eq!(server.connections[&token].drain_until, Some(deadline));
+    }
