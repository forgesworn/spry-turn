+        healthy
+            .set_read_timeout(Some(Duration::from_secs(2)))
+            .unwrap();
+        accept_stream(&mut server);
+        let healthy_token = *server.connections.keys().max_by_key(|t| t.0).unwrap();
+        for (client, token) in clients.iter_mut().zip(&tokens) {
+            client
+                .write_all(&indication.repeat(STREAM_FRAMES_PER_TURN + 1))
+                .unwrap();
