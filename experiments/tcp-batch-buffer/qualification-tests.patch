+    #[cfg(all(feature = "connected-udp", unix))]
+    fn coalescing_read(server: &mut Server, client: &mut std::net::TcpStream, expected: &[u8]) {
+        let deadline = Instant::now() + Duration::from_secs(5);
+        let mut received = Vec::new();
+        let mut scratch = [0; 16_384];
+        while received.len() < expected.len() && Instant::now() < deadline {
+            match client.read(&mut scratch) {
+                Ok(0) => panic!("accepted prefix closed before complete delivery"),
+                Ok(n) => received.extend_from_slice(&scratch[..n]),
+                Err(error) if error.kind() == io::ErrorKind::WouldBlock => (),
+                Err(error) => panic!("coalesced read: {error}"),
+            }
+            server.poll_once(Duration::from_millis(1)).unwrap();
+        }
+        assert_eq!(received, expected, "every accepted byte remains ordered");
+    }
