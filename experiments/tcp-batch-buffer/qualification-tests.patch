+    #[test]
+    fn coalescing_partial_writes_resume_the_exact_tail_after_writer_wouldblock() {
+        struct Partial {
+            bytes: Vec<u8>,
+            allowance: usize,
+        }
+        impl Write for Partial {
+            fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+                if self.allowance == 0 {
+                    return Err(io::ErrorKind::WouldBlock.into());
+                }
+                let n = bytes.len().min(self.allowance).min(7);
+                self.bytes.extend_from_slice(&bytes[..n]);
+                self.allowance -= n;
+                Ok(n)
+            }
+            fn flush(&mut self) -> io::Result<()> {
+                Ok(())
+            }
+        }
+        let expected = [coalescing_frame(1, 16), coalescing_frame(2, 16)].concat();
+        let mut socket = Partial {
+            bytes: Vec::new(),
+            allowance: 11,
+        };
+        let mut budget = WriteBudget::new();
+        let mut writer = LimitedWriter {
+            socket: &mut socket,
+            budget: &mut budget,
+        };
+        let first = writer.write(&expected).unwrap();
+        let second = writer.write(&expected[first..]).unwrap();
+        assert_eq!((first, second), (7, 4));
+        assert_eq!(
+            writer.write(&expected[11..]).unwrap_err().kind(),
+            io::ErrorKind::WouldBlock
+        );
+        assert_eq!(budget.blocked(), StreamFlush::Blocked);
+        assert_eq!(socket.bytes, expected[..11]);
+        socket.allowance = usize::MAX;
+        let mut offset = 11;
+        while offset < expected.len() {
+            let mut writer = LimitedWriter {
+                socket: &mut socket,
+                budget: &mut budget,
+            };
+            offset += writer.write(&expected[offset..]).unwrap();
+        }
+        assert_eq!(socket.bytes, expected);
+    }
