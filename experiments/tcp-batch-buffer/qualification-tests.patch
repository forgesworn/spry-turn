+            STREAM_DRAIN_TIMEOUT.as_millis()
+        );
+        // A transient WouldBlock can later drain into unread kernel buffers.
+        // Remove writable events to isolate the fixed deadline from that race.
+        server
+            .poll
+            .registry()
+            .deregister(&mut server.connections.get_mut(&token).unwrap().socket)
+            .unwrap();
+        server
+            .poll
+            .poll(&mut Events::with_capacity(16), Some(Duration::ZERO))
+            .unwrap();
+        let mut polls = 0;
+        while server.connections.contains_key(&token) && began.elapsed() < Duration::from_secs(4) {
+            assert!(
+                server.pending_streams.is_empty(),
+                "kernel pressure must wait for readiness/deadline"
+            );
+            server.poll_once(Duration::from_secs(1)).unwrap();
+            polls += 1;
