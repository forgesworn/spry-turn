+    #[cfg(all(feature = "tls", feature = "connected-udp", unix))]
+    fn delivery_tls_application_tail_resumes_after_ciphertext_capacity_returns() {
+        let (_files, mut server, mut client, token) = tls_loopback();
+        let conn = server.connections.get_mut(&token).unwrap();
+        socket2::SockRef::from(&conn.socket)
+            .set_send_buffer_size(1_048_576)
+            .unwrap();
+        let tls = conn.tls.as_mut().unwrap();
+        tls.set_buffer_limit(Some(4096));
+        let first = tls.writer().write(&[0x5a; 8192]).unwrap();
+        assert!(first > 0);
+        assert_eq!(tls.writer().write(&[0x5a]).unwrap(), 0);
+        assert!(tls.wants_write(), "TLS ciphertext fills its bounded buffer");
+        conn.queue(&[0x5a; 8192]).unwrap();
+        conn.update_interest(server.poll.registry(), token, true)
+            .unwrap();
+        assert!(!conn.queued);
+        let mut events = Events::with_capacity(16);
+        let deadline = Instant::now() + Duration::from_secs(2);
+        loop {
+            server
+                .poll
+                .poll(&mut events, Some(Duration::from_millis(10)))
+                .unwrap();
+            if events
+                .iter()
+                .any(|event| event.token() == token && event.is_writable())
+            {
+                break;
+            }
+            assert!(
+                Instant::now() < deadline,
+                "existing writable event was not observed"
+            );
+        }
+
+        // Consume the already-registered writable event before manual recovery.
+        // No new client input or readiness edge is supplied afterwards.
+        server.stream(token, &mut [0; MAX_PACKET + HEADROOM]);
+        let conn = &server.connections[&token];
+        assert!(
+            !conn.tls.as_ref().unwrap().wants_write(),
+            "socket drained TLS records"
+        );
+        eprintln!(
+            "tls_tail first={first} app_remaining={} write_interest={} queued={}",
+            conn.output.len() - conn.written,
+            conn.writable_interest,
+            conn.queued
+        );
+        assert!(
+            conn.output.is_empty(),
+            "freed TLS capacity must resume the accepted app tail"
+        );
+        assert!(!conn.writable_interest);
+        let mut received = 0;
+        let mut bytes = [0; 16_384];
+        let deadline = Instant::now() + Duration::from_secs(2);
+        while received < first + 8192 && Instant::now() < deadline {
+            match client.read(&mut bytes) {
+                Ok(n) => {
+                    assert!(n != 0);
+                    assert!(bytes[..n].iter().all(|byte| *byte == 0x5a));
+                    received += n;
+                }
+                Err(error) if error.kind() == io::ErrorKind::WouldBlock => (),
+                Err(error) => panic!("TLS tail read: {error}"),
+            }
+        }
+        assert_eq!(received, first + 8192);
+    }
