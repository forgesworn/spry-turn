+    fn wait_for_stream_eof(server: &Server, token: Token) {
+        let deadline = Instant::now() + Duration::from_secs(2);
+        loop {
+            match server.connections[&token].socket.peek(&mut [0]) {
+                Ok(0) => return,
+                Err(error) if error.kind() == io::ErrorKind::WouldBlock => (),
+                result => panic!("expected only TCP FIN, not new request data: {result:?}"),
+            }
+            assert!(Instant::now() < deadline, "peer FIN did not arrive");
+            std::thread::yield_now();
+        }
+    }
