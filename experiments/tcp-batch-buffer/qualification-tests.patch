+    #[cfg(all(feature = "connected-udp", unix))]
+    fn backpressured_stream() -> (Server, std::net::TcpStream, Token, usize) {
+        let mut config = Config::local(vec![1; 32]);
+        config.listen.set_port(0);
+        let mut server = Server::bind(config).unwrap();
+        // Set the receive allowance before SYN negotiates the TCP window.
+        // Reducing it afterwards may leave room for the whole accepted tail.
+        let socket = socket2::Socket::new(
+            socket2::Domain::IPV4,
+            socket2::Type::STREAM,
+            Some(socket2::Protocol::TCP),
+        )
+        .unwrap();
+        socket.set_recv_buffer_size(4096).unwrap();
+        socket
+            .connect_timeout(&server.local_addr().unwrap().into(), Duration::from_secs(2))
+            .unwrap();
+        let client: std::net::TcpStream = socket.into();
+        client.set_nonblocking(true).unwrap();
+        accept_stream(&mut server);
+        let token = *server.connections.keys().next().unwrap();
+        socket2::SockRef::from(&server.connections[&token].socket)
+            .set_send_buffer_size(1024)
+            .unwrap();
+        let payload = [0x5a; 32_768];
+        let mut accepted = 0;
+        let mut blocked = false;
+        for _ in 0..1024 {
+            server.send_client(Client::Stream(token), &payload);
+            accepted += payload.len();
+            let conn = server
+                .connections
+                .get_mut(&token)
+                .expect("bounded accepted queue");
+            if conn.written != conn.output.len() {
+                // Interest or pending output alone is not evidence of kernel pressure.
+                match conn.socket.write(&[0x5a]) {
+                    Err(error) if error.kind() == io::ErrorKind::WouldBlock => {
+                        blocked = true;
+                        break;
+                    }
+                    Ok(n) => accepted += n,
+                    result => panic!("kernel pressure probe: {result:?}"),
+                }
+            }
+        }
+        assert!(blocked, "fixture must observe actual kernel WouldBlock");
+        assert!(server.connections[&token].writable_interest);
+        (server, client, token, accepted)
+    }
