+#[cfg(test)]
+mod udp_buffer_diagnostic_tests {
+    use super::*;
+    use std::cell::{Cell, RefCell};
+    use std::ffi::OsStr;
+
+    fn assert_selected_logging(value: Option<&OsStr>, mode: UdpSendBufferMode, expected: u32) {
+        let diagnostics = UdpBufferDiagnostics::from_value(value).unwrap();
+        assert_eq!(diagnostics.mode, mode);
+        let emitted = Cell::new(0);
+        diagnostics
+            .emit_if_selected(|| {
+                emitted.set(emitted.get() + 1);
+                Ok(())
+            })
+            .unwrap();
+        assert_eq!(emitted.get(), expected);
+        let failed =
+            diagnostics.emit_if_selected(|| Err(io::Error::other("selected logging refusal")));
+        assert_eq!(failed.is_err(), expected != 0);
+    }
+
+    #[test]
+    fn udp_buffer_diagnostic_defaults_to_the_existing_floor() {
+        assert_selected_logging(None, UdpSendBufferMode::Floor, 0);
+        assert_eq!(
+            udp_send_buffer_mode(None).unwrap(),
+            UdpSendBufferMode::Floor
+        );
+    }
+
+    #[test]
+    fn udp_buffer_diagnostic_on_selects_the_existing_floor() {
+        assert_selected_logging(Some(OsStr::new("on")), UdpSendBufferMode::Floor, 1);
+        assert_eq!(
+            udp_send_buffer_mode(Some(OsStr::new("on"))).unwrap(),
+            UdpSendBufferMode::Floor
+        );
+    }
+
+    #[test]
+    fn udp_buffer_diagnostic_off_selects_native_without_an_environment_mutation() {
+        assert_selected_logging(Some(OsStr::new("off")), UdpSendBufferMode::Native, 1);
+        assert_eq!(
+            udp_send_buffer_mode(Some(OsStr::new("off"))).unwrap(),
+            UdpSendBufferMode::Native
+        );
+    }
+
+    #[test]
+    fn udp_buffer_diagnostic_refuses_malformed_values() {
+        for value in ["", "ON", "OFF", " on", "off ", "0", "1", "true", "native"] {
+            assert_eq!(
+                udp_send_buffer_mode(Some(OsStr::new(value)))
+                    .unwrap_err()
+                    .kind(),
+                io::ErrorKind::InvalidInput
+            );
+        }
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn udp_buffer_diagnostic_refuses_non_unicode_values() {
+        use std::os::unix::ffi::OsStrExt;
+        assert_eq!(
+            udp_send_buffer_mode(Some(OsStr::from_bytes(&[0xff])))
+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::InvalidInput
+        );
+    }
+
+    fn probe(
+        mode: UdpSendBufferMode,
+        initial: usize,
+        clamp: usize,
+        refuse_set: bool,
+    ) -> (io::Result<()>, UdpBufferFact, Vec<usize>) {
+        let send = Cell::new(initial);
+        let sets = RefCell::new(Vec::new());
+        let mut record = None;
+        let result = inspect_udp_send_buffer(
+            mode,
+            "relay",
+            7,
+            || Ok(send.get()),
+            |value| {
+                sets.borrow_mut().push(value);
+                if refuse_set {
+                    return Err(io::ErrorKind::PermissionDenied.into());
+                }
+                send.set(value.min(clamp));
+                Ok(())
+            },
+            || Ok(786_896),
+            |fact, result| {
+                record = Some((*fact, result.is_ok()));
+                Ok(())
+            },
+        );
+        let (fact, emitted_ok) = record.unwrap();
+        assert_eq!(emitted_ok, result.is_ok());
+        (result, fact, sets.into_inner())
+    }
+
+    #[test]
+    fn udp_buffer_diagnostic_both_modes_emit_actual_values_without_shrinking() {
+        for (mode, initial, after, expected_sets) in [
+            (UdpSendBufferMode::Floor, 9_216, 65_536, vec![65_536]),
+            (UdpSendBufferMode::Native, 9_216, 9_216, vec![]),
+            (UdpSendBufferMode::Floor, 1_048_576, 1_048_576, vec![]),
+        ] {
+            let (result, fact, sets) = probe(mode, initial, usize::MAX, false);
+            result.unwrap();
+            assert_eq!(fact.mode, mode);
+            assert_eq!(fact.role, "relay");
+            assert_eq!(fact.socket_ordinal, 7);
+            assert_eq!(fact.send_before, Some(initial));
+            assert_eq!(fact.send_after, Some(after));
+            assert_eq!(fact.receive_before, Some(786_896));
+            assert_eq!(fact.receive_after, Some(786_896));
+            assert_eq!(sets, expected_sets);
+        }
+    }
+
+    #[test]
+    fn udp_buffer_diagnostic_refusal_still_emits_the_actual_after_state() {
+        for (clamp, refuse_set, after, kind) in [
+            (32_768, false, 32_768, io::ErrorKind::Other),
+            (usize::MAX, true, 9_216, io::ErrorKind::PermissionDenied),
+        ] {
+            let (result, fact, sets) = probe(UdpSendBufferMode::Floor, 9_216, clamp, refuse_set);
+            assert_eq!(result.unwrap_err().kind(), kind);
+            assert_eq!(fact.send_after, Some(after));
+            assert_eq!(fact.receive_after, Some(786_896));
+            assert_eq!(sets, [65_536]);
+        }
+    }
+
+    #[test]
+    fn udp_buffer_diagnostic_post_observation_cannot_clear_an_initial_failure() {
+        let calls = Cell::new(0);
+        let mut record = None;
+        let result = inspect_udp_send_buffer(
+            UdpSendBufferMode::Native,
+            "listener",
+            1,
+            || {
+                calls.set(calls.get() + 1);
+                if calls.get() == 1 {
+                    Err(io::ErrorKind::PermissionDenied.into())
+                } else {
+                    Ok(9_216)
+                }
+            },
+            |_| panic!("native mode must not change a socket option"),
+            || Ok(786_896),
+            |fact, result| {
+                record = Some(*fact);
+                assert!(result.is_err());
+                Ok(())
+            },
+        );
+        assert_eq!(result.unwrap_err().kind(), io::ErrorKind::PermissionDenied);
+        let fact = record.unwrap();
+        assert_eq!(fact.send_before, None);
+        assert_eq!(fact.send_after, Some(9_216));
+        assert_eq!(fact.receive_after, Some(786_896));
+    }
+
+    #[test]
+    fn udp_buffer_diagnostic_log_failure_is_not_a_silent_success() {
+        let result = inspect_udp_send_buffer(
+            UdpSendBufferMode::Native,
+            "listener",
+            1,
+            || Ok(9_216),
+            |_| panic!("native mode must not change a socket option"),
+            || Ok(786_896),
+            |_, result| {
+                assert!(result.is_ok());
+                Err(io::ErrorKind::BrokenPipe.into())
+            },
+        );
+        assert_eq!(result.unwrap_err().kind(), io::ErrorKind::BrokenPipe);
+    }
+}
