+
+impl TcpReturnBatch {
+    fn new(enabled: bool) -> Self {
+        Self {
+            enabled,
+            frames: 0,
+            bytes: 0,
+        }
+    }
+
+    fn would_exceed(&self, bytes: usize) -> bool {
+        self.frames != 0
+            && (self.frames >= TCP_RETURN_BATCH_FRAMES
+                || bytes > TCP_RETURN_BATCH_BYTES.saturating_sub(self.bytes))
+    }
+
+    fn full(&self) -> bool {
+        self.frames >= TCP_RETURN_BATCH_FRAMES || self.bytes >= TCP_RETURN_BATCH_BYTES
+    }
+
+    fn clear(&mut self) -> bool {
+        let pending = self.frames != 0;
+        self.frames = 0;
+        self.bytes = 0;
+        pending
+    }
