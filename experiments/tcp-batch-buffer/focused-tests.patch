+    #[test]
+    fn batch_output_full_queue_keeps_frame_refusal_and_control_reserve() {
+        let (mut server, _clients, tokens) = batch_output_fixture(1);
+        let token = tokens[0];
+        let key = Client::Stream(token);
+        server.tcp_return_output = Vec::with_capacity(TCP_RETURN_BATCH_BYTES);
+        let shared_pointer = server.tcp_return_output.as_ptr();
+        let fill = vec![0x31; MAX_QUEUE - STREAM_CONTROL_RESERVE];
+        server
+            .connections
+            .get_mut(&token)
+            .unwrap()
+            .queue(&fill)
+            .unwrap();
+        let pointer = server.connections[&token].output.as_ptr();
+        assert!(!server.swap_empty_peer_output(key));
+        let mut batch = server.peer_return_batch(key);
+        assert!(batch.enabled);
+        assert!(!server.send_peer_packet(key, &[0x42; 8], &mut batch));
+        assert_eq!(server.connections[&token].output, fill);
+        assert_eq!(server.connections[&token].output.as_ptr(), pointer);
+        assert_eq!(server.connections[&token].written, 0);
+        assert_eq!(server.stats.dropped_packets, 1);
+        assert_eq!(batch.frames, 0);
+        assert_eq!(server.tcp_return_output.as_ptr(), shared_pointer);
+        // Queue-level control admission is modelled without flushing to a socket.
+        let conn = server.connections.get_mut(&token).unwrap();
+        conn.queue(&vec![0x53; STREAM_CONTROL_RESERVE]).unwrap();
+        assert!(conn.queue(&[0x64]).is_err());
+        assert_eq!(conn.output.len(), MAX_QUEUE);
+        assert_eq!(&conn.output[..fill.len()], fill);
+        assert!(conn.output[fill.len()..].iter().all(|byte| *byte == 0x53));
+        assert!(!server.swap_empty_peer_output(key));
+    }
